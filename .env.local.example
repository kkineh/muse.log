# Supabase Configuration
# Get these values from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Configuration
# Only this email will be allowed to access /admin routes
NEXT_PUBLIC_ADMIN_EMAIL=your-admin-email@example.com

# OpenAI API Configuration (for RAG chatbot)
OPENAI_API_KEY=sk-proj-...

# Note: After setting up Supabase, also configure in Supabase Dashboard:
# Settings > API > Custom PostgreSQL configuration
# Add: app.admin_email = 'your-admin-email@example.com'

# Vercel Cron auth (sent as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=random-string-of-16-plus-chars

# On-demand revalidation for the brain publish script (POST /api/revalidate).
# 32+ bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in Vercel (Production) and in .env.brain.local.
REVALIDATE_SECRET=random-hex-string-of-32-plus-bytes

# Brain publish/export scripts (scripts/brain-*.mjs) read a separate file,
# .env.brain.local (gitignored, never loaded by Next.js):
#   SUPABASE_SERVICE_ROLE_KEY=<service_role secret key, never put in Vercel>
#   SITE_URL=https://<blog domain>
#   REVALIDATE_SECRET=<same value as above>
